#!/usr/bin/env python3
"""Control an LT716 smart band (FitPro protocol, Telink chip) over BLE via BlueZ D-Bus.

Usage:
  ./lt716 info                       name, MAC, firmware, feature string, battery
  ./lt716 battery                    battery level (0x2A19)
  ./lt716 settime                    set band clock to local time (12 01)
  ./lt716 find                       "find band" vibration (12 0B)
  ./lt716 notify [-t type] <text>    notification, up to 300 bytes UTF-8 (12 12)
                                     types: sms qq wechat facebook twitter skype line
                                     whatsapp (default) kakaotalk snapchat tiktok instagram
                                     linkedin telegram okru vk tenchat viber messenger zalo
  ./lt716 alerts on|off              enable/disable notifications for every app and calls
                                     (12 07); when off the band ignores notify and call
  ./lt716 call [-s seconds] <caller> incoming call, ended after N s (default 10) (12 11)
  ./lt716 alarms [file]              program alarms from a weekly list (default alarms.txt)
  ./lt716 alarms --show              print the alarms stored on the band (18)
  ./lt716 camera on|off              remote shutter mode (12 0C); presses show in "live"
  ./lt716 goal <steps>               daily step goal (12 03)
  ./lt716 profile [key=value...]     user info (12 04): gender=male|female age= height=cm
                                     weight=kg unit=km|mi; missing keys keep the band's value
  ./lt716 lift on|off [HH-HH]        raise to wake, active window (12 09), default 08-22
  ./lt716 dnd on|off [HH-HH]         do not disturb window (12 14), default 22-08
  ./lt716 lang <code>                display language (12 15), e.g. it en de fr es
  ./lt716 settings                   read and decode the band's settings (1A <key>)
  ./lt716 steps                      today's totals: steps, distance, calories (15 0D)
  ./lt716 measure hr|bp|spo2 [secs]  start a measurement and print the results (12 24),
                                     default 60 s
  ./lt716 live [seconds]             print events: steps, shutter, find phone, music keys,
                                     stored records (default 60 s, 0 = until Ctrl+C)
  ./lt716 ota <file.bin> [--dry-run|--yes]
                                     firmware update over the Telink OTA service; without
                                     --yes it only checks the image and builds the packets
  ./lt716 ota --enter-updater        start an OTA without data: the stock firmware reboots
                                     into the vendor updater (bank 0x20000) after ~40 s
  ./lt716 dumper info|dump [file]|assets <src.bin>|touchlog [s]|speed <1..16>|battery|sensors|lcd ...|updater|reboot
                                     talk to the flash dumper (firmware/dumper) once it runs
  ./lt716 reset --yes                factory reset (1D)
  ./lt716 raw <hex> [<hex>...]       send raw packets to the UART and print the replies

Env: MAC (default FF:FF:CF:10:70:E9), HCI (default hci0), RETRIES (default 5)
Dependencies: python3-dbus, python3-gi. The band must already be paired.
"""

